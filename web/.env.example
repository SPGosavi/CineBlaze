# ─── Backend ────────────────────────────────────────────────────────────────
# Origin of the Express API, as seen from the Next.js server.
# Server Components call this directly; browser requests to /api/* are
# rewritten here by next.config.ts. Not NEXT_PUBLIC_, so it never reaches the
# client bundle.
BACKEND_API_URL=http://localhost:5001

# ─── Site ───────────────────────────────────────────────────────────────────
# Canonical origin. Used for Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Firebase ───────────────────────────────────────────────────────────────
# Same values as frontend/.env, with the VITE_ prefix swapped for
# NEXT_PUBLIC_. These are client-side config, not secrets — Firebase security
# rules are what protect the data.
# Leave them unset to run without auth: discovery, search and detail pages all
# work signed out, only the watchlist is disabled.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
