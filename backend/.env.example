# ─── Required ───────────────────────────────────────────────────────────────
PORT=5001
GROQ_API_KEY=
TMDB_API_KEY=
OMDB_API_KEY=

# ─── Optional infrastructure ────────────────────────────────────────────────
# Every value below is optional. The API starts and serves traffic with only
# the keys above; each integration degrades instead of failing. Use /health to
# confirm which ones are actually live, because a typo here fails open.

# Redis. `rediss://` for Upstash and other TLS providers.
# Unset: falls back to an in-process cache (lost on restart, not shared).
REDIS_URL=

# Postgres (Neon, Supabase, Railway…).
# Unset: search history and taste profiles are disabled. Nothing else changes.
DATABASE_URL=

# Firebase project id — used to verify ID tokens against Google's public JWKS.
# No service-account JSON needed. Unset: every request is anonymous, so rate
# limits fall back to per-IP.
FIREBASE_PROJECT_ID=

# Shared secret required as `x-api-key`. Must match the value in web/.env.local.
# Unset: the API is open, which is the right default locally and was the
# behaviour before Phase 4.
INTERNAL_API_KEY=

# Comma-separated allowed browser origins. Unset: `*`.
# In production this should be the web app's origin.
CORS_ORIGINS=

# Sentry DSN. Unset: errors go to the structured logs only.
SENTRY_DSN=

# ─── Tuning ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=debug
# OUTBOUND_CONCURRENCY=8
# RATE_LIMIT_AI_PER_HOUR=30
# RATE_LIMIT_TMDB_PER_HOUR=100
# RATE_LIMIT_IP_PER_SECOND=10
# RATE_LIMIT_DISABLED=false
# ENABLE_BACKGROUND_JOBS=true
