# ==============================================================================
# CineBlaze — Root Environment Configuration Reference (.env.example)
# ==============================================================================
#
# CineBlaze follows a "graceful degradation" philosophy:
# - The backend starts and serves core search & trending features on a developer
#   laptop with only 3 required API keys (GROQ, TMDB, OMDB).
# - Every infrastructure component (Redis, Postgres, Firebase Auth, Sentry) is
#   strictly optional and fails open:
#   - No Redis: In-process memory store with LRU/TTL caching.
#   - No Postgres: Persistence/taste profiles disabled without failing requests.
#   - No Firebase: Anonymous access; public discover & search work smoothly.
#   - No Sentry: Structured JSON logging to stdout via Pino.
#
# Workspace configurations:
# - backend/.env: Variables used by the Express backend API.
# - web/.env.local: Variables used by the Next.js BFF and frontend.
#
# ==============================================================================
# 1. BACKEND REQUIRED VARIABLES (Core API)
# ==============================================================================

# Port for Express API server (default: 5001 for local dev, or 8000)
PORT=5001

# Groq API key for LLM conversational search & semantic query extraction
# Get one at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# TMDB (The Movie Database) v3 API key for movie/series metadata and images
# Get one at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API key for IMDb ratings, Rotten Tomatoes scores & runtime resolution
# Get one at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# ==============================================================================
# 2. BACKEND OPTIONAL INFRASTRUCTURE (Graceful Degradation)
# ==============================================================================

# Node environment mode: development | production | test
NODE_ENV=development

# Postgres connection URI with pgvector support (e.g. Neon, Supabase, Railway, local).
# Optional: If unset, user event history, taste profiles, and search recordings
# are skipped gracefully with zero user-facing errors.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cineblaze?sslmode=disable

# Database SSL mode: auto | require | disable
# Optional: Auto-detects based on remote vs local hostnames.
DATABASE_SSL_MODE=auto

# Redis connection URI (e.g. Upstash `rediss://...` or local `redis://...`).
# Optional: If unset, falls back to in-process memory store.
REDIS_URL=redis://localhost:6379

# Firebase Project ID for verifying user ID tokens against Google's public JWKS.
# Optional: If unset, requests are treated as anonymous.
FIREBASE_PROJECT_ID=cineblaze-app

# Shared secret between Next.js server (BFF) and Express backend API.
# Optional: If unset, API is open without key enforcement for friction-free dev.
# In production, must match INTERNAL_API_KEY in web/.env.local.
INTERNAL_API_KEY=your_shared_internal_api_secret_here

# Allowed CORS origins (comma-separated).
# Optional: If unset, defaults to `*` in development. In production, set to web app origin.
CORS_ORIGINS=http://localhost:3000

# Sentry DSN for backend runtime exception reporting.
# Optional: If unset, errors are logged locally via Pino.
SENTRY_DSN=

# Pino logger level: debug | info | warn | error | silent
LOG_LEVEL=debug

# Rate limit tuning:
# RATE_LIMIT_AI_PER_HOUR=30
# RATE_LIMIT_TMDB_PER_HOUR=100
# RATE_LIMIT_IP_PER_SECOND=10
# RATE_LIMIT_DISABLED=false
# ENABLE_BACKGROUND_JOBS=true
# OUTBOUND_CONCURRENCY=8

# ==============================================================================
# 3. WEB (NEXT.JS) CONFIGURATION
# ==============================================================================

# Origin of the backend Express API, as seen from Next.js server components.
# Server-only (never bundled into client JavaScript).
BACKEND_API_URL=http://localhost:5001

# Canonical site origin for SEO, sitemaps, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase client SDK configuration (publicly visible in client bundle).
# Optional: If unset, discovery and search work fine; watchlist is disabled.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cineblaze-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cineblaze-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cineblaze-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
